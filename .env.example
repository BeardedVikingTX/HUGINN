# =============================================================================
#  HUGINN :: .env.example
#  Copy to .env and fill in your actual values.
#  NEVER commit the real .env to git.
# =============================================================================

# ---- DeepSeek API ----------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: cache hit vs miss pricing. Purely informational for cost tracking.
DEEPSEEK_PRICE_INPUT_CACHE=0.003
DEEPSEEK_PRICE_INPUT_MISS=0.15
DEEPSEEK_PRICE_OUTPUT=0.6

# ---- HUGINN AI behavior ----------------------------------------------------
# Set to 0 to disable AI entirely. Set to 1 to enable.
HUGINN_AI_ENABLED=1
# Max tokens per API response
HUGINN_AI_MAX_TOKENS=2048
# Temperature (0.0 = deterministic, 1.0 = creative)
HUGINN_AI_TEMPERATURE=0.2
# Timeout per request (seconds)
HUGINN_AI_TIMEOUT=60
# Daily spend cap in USD — refuses to call the API if exceeded
HUGINN_AI_DAILY_BUDGET_USD=2.00
